{
  "tagName": "nr-guide-card",
  "state": { "href": "/docs/", "kicker": "", "title": "", "text": "" },
  "style": { "display": "block" },
  "children": [
    {
      "tagName": "a",
      "attributes": { "href": "${state.href}" },
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "0.35rem",
        "height": "100%",
        "boxSizing": "border-box",
        "padding": "1.35rem 1.5rem",
        "borderRadius": "var(--radius-lg)",
        "border": "1px solid var(--color-border)",
        "borderTop": "3px solid var(--color-accent)",
        "backgroundColor": "var(--color-bg-primary)",
        "color": "var(--color-text-primary)",
        "textDecoration": "none",
        "transition": "border-color 0.15s, box-shadow 0.15s",
        ":hover": {
          "color": "var(--color-text-primary)",
          "borderColor": "var(--color-accent)",
          "boxShadow": "0 6px 18px var(--color-shadow)"
        }
      },
      "children": [
        {
          "tagName": "span",
          "style": {
            "fontFamily": "var(--font-mono)",
            "fontSize": "0.75rem",
            "textTransform": "uppercase",
            "letterSpacing": "0.08em",
            "color": "var(--color-accent)"
          },
          "textContent": "${state.kicker}"
        },
        {
          "tagName": "strong",
          "style": { "fontFamily": "var(--font-display)", "fontSize": "1.125rem" },
          "textContent": "${state.title}"
        },
        {
          "tagName": "span",
          "style": { "fontSize": "0.9375rem", "color": "var(--color-text-secondary)", "lineHeight": "1.55" },
          "textContent": "${state.text}"
        },
        {
          "tagName": "span",
          "style": { "marginTop": "auto", "paddingTop": "0.5rem", "fontSize": "0.875rem", "fontWeight": "600", "color": "var(--color-accent)" },
          "textContent": "Read the guide →"
        }
      ]
    }
  ]
}
