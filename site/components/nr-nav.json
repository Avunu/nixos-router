{
  "tagName": "nr-nav",
  "$elements": [{ "$ref": "./site-search.json" }],
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "100",
    "height": "3.5rem",
    "boxSizing": "border-box",
    "backgroundColor": "var(--color-backdrop-strong)",
    "backdropFilter": "blur(12px)",
    "borderBottom": "1px solid var(--color-border)",
    "padding": "0 clamp(1rem, 3vw, 2rem)"
  },
  "children": [
    {
      "tagName": "nav",
      "attributes": { "aria-label": "Main" },
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "space-between",
        "height": "100%",
        "gap": "1rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/", "aria-label": "nixos-router home" },
          "style": {
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "fontFamily": "var(--font-display)",
            "fontWeight": "700",
            "fontSize": "1.0625rem",
            "letterSpacing": "-0.01em",
            "display": "flex",
            "alignItems": "center",
            "gap": "0.55rem",
            ":hover": { "color": "var(--color-text-primary)" }
          },
          "children": [
            {
              "tagName": "img",
              "attributes": { "src": "/favicon.svg", "alt": "", "width": "26", "height": "26" }
            },
            "nixos-router"
          ]
        },
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "clamp(0.75rem, 2.5vw, 1.5rem)",
            "fontSize": "0.9375rem",
            "fontWeight": "500",
            "& a": { "color": "var(--color-text-secondary)", "textDecoration": "none" },
            "& a:hover": { "color": "var(--color-text-primary)" }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/docs/start/" },
              "style": { "@--sm": { "display": "none" } },
              "textContent": "Get started"
            },
            { "tagName": "a", "attributes": { "href": "/docs/" }, "textContent": "Docs" },
            {
              "tagName": "a",
              "attributes": {
                "href": "https://github.com/Avunu/nixos-router",
                "target": "_blank",
                "rel": "noopener noreferrer"
              },
              "textContent": "GitHub"
            },
            { "tagName": "site-search" }
          ]
        }
      ]
    }
  ]
}
