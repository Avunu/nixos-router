{
  "$layout": "./layouts/docs.json",
  "$paths": {
    "contentType": "docs",
    "param": "slug",
    "field": "id"
  },
  "title": "${state.page.data.title} · nixos-router",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "${state.page.data.description}"
      }
    }
  ],
  "state": {
    "page": {
      "$prototype": "ContentEntry",
      "contentType": "docs",
      "id": {
        "$ref": "#/$params/slug"
      }
    }
  },
  "children": [
    {
      "tagName": "article",
      "style": {
        "maxWidth": "760px",
        "& img": {
          "display": "block",
          "maxWidth": "100%",
          "maxHeight": "900px",
          "width": "auto",
          "height": "auto",
          "borderRadius": "8px",
          "border": "1px solid var(--color-border)",
          "margin": "1.75rem auto"
        },
        "& kbd": {
          "display": "inline-block",
          "padding": "0.125rem 0.375rem",
          "fontSize": "0.8125rem",
          "fontFamily": "var(--font-mono)",
          "color": "var(--color-text-primary)",
          "backgroundColor": "var(--color-bg-surface)",
          "border": "1px solid var(--color-border)",
          "borderBottomWidth": "2px",
          "borderRadius": "4px"
        },
        "& pre": {
          "backgroundColor": "var(--color-bg-surface)",
          "border": "1px solid var(--color-border)",
          "borderRadius": "var(--radius)",
          "padding": "1rem 1.25rem",
          "overflowX": "auto",
          "fontSize": "0.875rem",
          "lineHeight": "1.6"
        },
        "& pre span": {
          "color": "var(--shiki-light)"
        },
        "@--dark": {
          "& pre span": {
            "color": "var(--shiki-dark)"
          }
        },
        "& code": {
          "fontFamily": "var(--font-mono)",
          "fontSize": "0.875em"
        },
        "& p code": {
          "backgroundColor": "var(--color-bg-surface)",
          "border": "1px solid var(--color-border-subtle)",
          "borderRadius": "4px",
          "padding": "0.1rem 0.3rem"
        },
        "& li code": {
          "backgroundColor": "var(--color-bg-surface)",
          "border": "1px solid var(--color-border-subtle)",
          "borderRadius": "4px",
          "padding": "0.1rem 0.3rem"
        },
        "& h2": {
          "marginTop": "2.5rem",
          "paddingTop": "0.25rem",
          "scrollMarginTop": "4.5rem"
        },
        "& h3": {
          "marginTop": "1.75rem",
          "scrollMarginTop": "4.5rem"
        },
        "& h1": {
          "fontSize": "clamp(1.9rem, 4vw, 2.4rem)",
          "margin": "0 0 1rem"
        },
        "@--md": {
          "& table": {
            "display": "block",
            "overflowX": "auto"
          }
        }
      },
      "children": "${state.page.$children ?? []}"
    },
    {
      "$title": "Edit link",
      "tagName": "div",
      "style": {
        "maxWidth": "760px",
        "marginTop": "3rem",
        "paddingTop": "1.25rem",
        "borderTop": "1px solid var(--color-border-subtle)",
        "fontSize": "0.875rem",
        "color": "var(--color-text-muted)"
      },
      "children": [
        "Found a mistake? ",
        {
          "tagName": "a",
          "attributes": {
            "href": "https://github.com/Avunu/nixos-router/edit/main/docs/${state.page.id}.md"
          },
          "textContent": "Edit this page on GitHub"
        },
        "."
      ]
    }
  ]
}
